# ---------------------------------------------------------------------------
# GPT-Image2-Studio — Docker deployment configuration
#
#   cp deploy/env.example .env
#
# This one file is used twice: Docker Compose reads it for ${...}
# interpolation, and the studio container receives all of it as environment
# variables. It is git-ignored — keep it that way, it holds secrets.
# ---------------------------------------------------------------------------

# === Container wiring ======================================================

# Host port for direct local access: http://127.0.0.1:3600
STUDIO_PORT=3600

# Tag applied by `docker compose build`.
STUDIO_TAG=latest

# REQUIRED. Shared secret for every non-loopback request. The browser is
# challenged with HTTP Basic auth: username "studio", password = this value.
# Compose refuses to start while it is empty.
#   generate one with:  openssl rand -hex 32
IMAGE_STUDIO_REQUEST_TOKEN=

# Time zone for the container and for log timestamps.
TZ=Asia/Shanghai

# Exposing the studio beyond this host is the reverse proxy's job — this stack
# ships none. See "接入自己的反代" in docs/docker-deployment.md for the four
# requirements your proxy must satisfy and a worked Traefik example.

# === Upstream providers ====================================================
# Fill in whichever route you actually use. These are read by the application
# at startup and may also be changed later from the in-app settings page,
# which persists them to /data/.local/config.json.

# --- Route mode (Responses API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RESPONSES_MODEL=gpt-6-luna
IMAGE_TOOL_MODEL=gpt-image-2
IMAGE_QUALITY=high

# --- Direct-call mode (separate image and text providers) ---
DIRECT_IMAGE_BASE_URL=https://api.openai.com/v1
DIRECT_IMAGE_API_KEY=
DIRECT_IMAGE_ENDPOINT_PATH=images/generations
DIRECT_IMAGE_MODEL=gpt-image-2
DIRECT_TEXT_BASE_URL=https://api.openai.com/v1
DIRECT_TEXT_API_KEY=
DIRECT_TEXT_ENDPOINT_PATH=responses
DIRECT_TEXT_MODEL=gpt-6-luna

# --- xAI Grok Imagine ---
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_ENDPOINT_PATH=images/generations
GROK_IMAGE_MODEL=grok-imagine-image-2.0

# === Retention (count-based cleanup of generated assets) ===================
# The studio never deletes anything on its own, so a background GC enforces two
# independent caps. It runs inside the same container (docker/entrypoint.sh) and
# needs no extra volume.
#
#   MAX_IMAGES  standalone generated images        (unit: one image file)
#   MAX_SETS    creation / portrait / article-illustration / ppt sets
#                                                 (unit: one whole set)
#
# A set is always evicted whole — image directory, metadata directory and
# manifest — because the manifest references individual image filenames;
# trimming inside a set would leave the UI listing files that no longer exist.
# Each evicted image takes its sidecar metadata with it.
#
# NOTE ON SIZE: the caps count items, not bytes. At the 2K/4K output sizes the
# app supports, one image runs 2-10 MB, so 500 images + 50 sets of 20 lands
# somewhere between roughly 3 GB and 20 GB. Size the volume for that range.
# These defaults are just defaults — uncomment and lower them for a small box.
#
# STUDIO_RETENTION_ENABLED=1
# STUDIO_RETENTION_MAX_IMAGES=500
# STUDIO_RETENTION_MAX_SETS=50
# How often to sweep, in seconds (default 300).
# STUDIO_RETENTION_INTERVAL_SEC=300
# Never evict anything touched more recently than this, in seconds (default
# 600). This is what keeps a long-running generation from being deleted
# half-way through; keep it comfortably above your longest single run.
# STUDIO_RETENTION_GRACE_SEC=600
# Set to 1 to log what would be removed without deleting anything. Useful for
# a first deployment before letting it loose.
# STUDIO_RETENTION_DRY_RUN=0

# === Optional tuning =======================================================

# Per-item upstream ceiling in ms (default 1200000 = 20 minutes). These long
# streams are why your reverse proxy must not set read/write timeouts.
# IMAGE_STUDIO_CREATION_UPSTREAM_TIMEOUT_MS=1200000
